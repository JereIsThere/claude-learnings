{
  "version": "1.0.0",
  "description": "Topic groupings for the claude-learnings repository. Each group bundles related learning paths by domain.",
  "groups": [
    {
      "id": "cs-theory-systems",
      "label": "CS Theory & Systems",
      "description": "Foundational computer science — how computers work from the ground up.",
      "topics": [
        "data-structures-algorithms",
        "discrete-math",
        "compiler-design",
        "operating-systems",
        "computer-networks",
        "databases"
      ]
    },
    {
      "id": "ai-ml-data-science",
      "label": "AI, ML & Data Science",
      "description": "Machine learning, deep learning, and the mathematical and data tooling that powers them.",
      "topics": [
        "tensorflow-keras",
        "computer-vision",
        "nlp",
        "pandas-data-wrangling",
        "statistics",
        "linear-algebra"
      ]
    },
    {
      "id": "software-engineering",
      "label": "Software Engineering & Architecture",
      "description": "Principles and practices for writing maintainable, well-structured software at scale.",
      "topics": [
        "design-patterns",
        "system-design",
        "functional-programming",
        "git-version-control"
      ]
    },
    {
      "id": "web-apis-security",
      "label": "Web, APIs & Security",
      "description": "Building and securing web services — from REST conventions to auth and performance.",
      "topics": [
        "api-rest",
        "oauth-2",
        "web-performance",
        "security-cryptography",
        "jinja-templates"
      ]
    },
    {
      "id": "devops-tooling",
      "label": "DevOps, Tooling & Automation",
      "description": "Infrastructure, containerisation, mobile targets, and developer productivity tools.",
      "topics": [
        "docker-containers",
        "android-emulator",
        "regex",
        "agent-tooling"
      ]
    },
    {
      "id": "creative-documentation",
      "label": "Creative & Documentation",
      "description": "Non-programming disciplines — visual arts, watercolour technique, and scientific typesetting.",
      "topics": [
        "art-advanced",
        "watercolor-mixing",
        "latex"
      ]
    }
  ],
